# ===================================================
# Class AI Environment Variables
# ===================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Gemini API Key (Required for Text Extraction, Chat & Vision)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Configuration (Optional - falls back to persistent SQLite if empty)
# Get from: https://supabase.com/
SUPABASE_URL=
SUPABASE_KEY=

# WhatsApp Cloud API Webhook Verification (Optional for simulator, required for live WhatsApp)
WHATSAPP_VERIFY_TOKEN=class_ai_secret_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
