rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi messages:
    // - Siapa saja dapat membaca (read = true) untuk feed web/dashboard
    // - Admin web dapat menghapus pesan (delete = true)
    // - Firebase Admin SDK membypass aturan ini secara otomatis
    match /messages/{messageId} {
      allow read: if true;
      allow delete: if true;
      allow write: if false;
    }

    // Koleksi bulletins (Catatan & Pengumuman)
    match /bulletins/{bulletinId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi deadlines (Tugas & Tenggat Waktu)
    match /deadlines/{deadlineId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi schedules (Jadwal Kuliah)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi summaries (Rangkuman Materi AI)
    match /summaries/{summaryId} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi quizzes (Latihan Kuis AI)
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Blokir akses ke dokumen/koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
